# Copy this file to .env.local and fill in the values from your Supabase project.
# Both values below are PUBLIC (they ship in the browser) — safe to expose.
# Find them in Supabase: Project Settings -> Data API / API.

# Your project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The publishable (public) key, starts with sb_publishable_...
# This replaces the old "anon key". Do NOT use the secret key (sb_secret_...) here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
